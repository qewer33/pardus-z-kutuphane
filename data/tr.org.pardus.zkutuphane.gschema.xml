<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="pardus-z-kutuphane">
	<schema id="tr.org.pardus.zkutuphane" path="/tr/org/pardus/zkutuphane/">
		<key name="width" type="i">
			<default>900</default>
			<summary>Window width</summary>
		</key>
		<key name="height" type="i">
			<default>640</default>
			<summary>Window height</summary>
		</key>
		<key name="maximized" type="b">
			<default>false</default>
			<summary>Window maximized state</summary>
		</key>
		<key name="wine-prefix" type="s">
			<default>'~/.local/share/tr.org.pardus.zkutuphane/wineprefix'</default>
			<summary>Default Wine prefix directory</summary>
			<description>Directory used for Wine bottles when launching Windows executables.</description>
		</key>
		<key name="log-dir" type="s">
			<default>'~/.local/state/tr.org.pardus.zkutuphane'</default>
			<summary>Log directory</summary>
			<description>Directory where application logs are stored.</description>
		</key>
		<key name="cache-dir" type="s">
			<default>'~/.cache/tr.org.pardus.zkutuphane'</default>
			<summary>Cache directory</summary>
			<description>Directory for cached data such as publisher icons.</description>
		</key>
		<key name="theme" type="s">
			<choices>
				<choice value="system"/>
				<choice value="light"/>
				<choice value="dark"/>
			</choices>
			<default>'system'</default>
			<summary>Application color theme</summary>
			<description>Preferred color theme: system to follow the desktop, or light/dark to force one.</description>
		</key>
		<key name="sort-by-launch-count" type="b">
			<default>true</default>
			<summary>Sort by launch count</summary>
			<description>Whether to sort books by the amount of times they have been launched.</description>
		</key>
	</schema>
</schemalist>
