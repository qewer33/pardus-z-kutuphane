import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

# make our GSettings schema discoverable when installed under a custom prefix
schema_dir = os.path.normpath(os.path.join(pkgdatadir, '..', 'glib-2.0', 'schemas'))
existing = os.environ.get('GSETTINGS_SCHEMA_DIR', '')
os.environ['GSETTINGS_SCHEMA_DIR'] = (
    schema_dir + os.pathsep + existing if existing else schema_dir
)

# make our installed icons (and other data) discoverable under a custom prefix;
# GTK searches $XDG_DATA_DIRS/icons for the app icon
datadir = os.path.normpath(os.path.join(pkgdatadir, '..'))
xdg_data_dirs = os.environ.get('XDG_DATA_DIRS', '/usr/local/share:/usr/share')
if datadir not in xdg_data_dirs.split(os.pathsep):
    os.environ['XDG_DATA_DIRS'] = datadir + os.pathsep + xdg_data_dirs

locale.bindtextdomain('pardus-z-kutuphane', localedir)
locale.textdomain('pardus-z-kutuphane')
gettext.bindtextdomain('pardus-z-kutuphane', localedir)
gettext.textdomain('pardus-z-kutuphane')

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'pardus-z-kutuphane.gresource'))
    resource._register()

    from pardus_z_kutuphane import main
    sys.exit(main.main(VERSION))
